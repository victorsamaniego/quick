# ==========================================
# VARIABLES DE ENTORNO (NUNCA SUBIR)
# ==========================================
.env
.env.local
.env.production

# ==========================================
# PYTHON
# ==========================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
env/
ENV/
.venv
*.egg-info/
dist/
build/

# ==========================================
# BASE DE DATOS (LOCAL)
# ==========================================
*.db
*.sqlite
*.sqlite3
instance/

# ==========================================
# UPLOADS (Archivos subidos por usuarios)
# ==========================================
# Ignoramos los archivos de imágenes y PDFs subidos
static/uploads/*.png
static/uploads/*.jpg
static/uploads/*.jpeg
static/uploads/*.gif
static/uploads/*.pdf
static/uploads/*.webp

# Mantenemos las subcarpetas vacías con .gitkeep
!static/uploads/.gitkeep
!static/uploads/receipts/.gitkeep
!static/uploads/logos/.gitkeep

# ==========================================
# IDE y EDITORES
# ==========================================
.vscode/
.idea/
*.swp
*.swo
*~

# ==========================================
# SISTEMA OPERATIVO
# ==========================================
.DS_Store
Thumbs.db
desktop.ini

# ==========================================
# LOGS
# ==========================================
*.log
security.log